# Billing / Checkout (for monetization)
# Configure your billing provider (e.g., Stripe) and webhook secret
BILLING_PROVIDER=stripe
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
